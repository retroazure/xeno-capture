<Window x:Class="XenoCapture.UI.PhoneScreenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone screen" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="Android over USB" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock x:Name="AndroidUsbHint"
               Text="Connect one Android phone with a USB data cable. Enable USB debugging, unlock the phone, then press Play and approve the request on the phone."
               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/>
    <TextBlock Text="Preview profile" Margin="0,6,0,4"/>
    <ComboBox x:Name="PreviewProfile" SelectedIndex="0" AutomationProperties.Name="Phone preview profile"
              ToolTip="Choose Responsive to reduce encoding load on older phones. The size is the maximum length of either edge.">
      <ComboBoxItem Content="Responsive · 1280 px / 30 FPS"/>
      <ComboBoxItem Content="Smooth · 1280 px / 60 FPS"/>
      <ComboBoxItem Content="High detail · 1920 px / 60 FPS"/>
    </ComboBox>
    <CheckBox x:Name="PhoneAudio" Content="Phone output · Android 11 or newer" Margin="0,8,0,4"/>
    <TextBlock Text="Routes the phone's sound to this PC during mirroring."
               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="PlayAndroidUsb" Content="Play Android over USB" IsDefault="True"
              Style="{StaticResource PrimaryButton}" Click="StartAndroidUsb"/>
    </StackPanel>
  </StackPanel>
</Window>
