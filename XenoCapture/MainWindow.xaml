<Window x:Class="XenoCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xeno Capture" Icon="UI/Xeno.ico" Width="1240" Height="850" MinWidth="1000" MinHeight="740"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid Margin="26,18,26,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="60"/><RowDefinition Height="24"/>
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border x:Name="BrandMark" Width="44" Height="44" CornerRadius="13" Background="{DynamicResource BrandBrush}" Margin="0,0,12,0">
          <Path Data="M 0,0 L 16,16 M 16,0 L 0,16" Stroke="{DynamicResource OnBrandBrush}" StrokeThickness="3.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Xeno Capture" FontSize="25" FontWeight="Bold" Margin="0,-3,0,0"/>
          <TextBlock Text="Console and phone capture" FontSize="11" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
        <Button x:Name="ThemeButton" Click="ToggleTheme" ToolTip="Switch between light and dark mode" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="◐" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="ThemeAction" Text="Light mode" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="FeedbackButton" Content="Feedback" Click="ShowFeedbackSettings" Margin="0,0,8,0"
                ToolTip="Interface sounds and animations"/>
        <Button Content="Recordings ↗" Click="OpenRecordings" Margin="0,0,8,0"/>
        <Button Content="?" ToolTip="About Xeno Capture" AutomationProperties.Name="About Xeno Capture" Click="ShowHelp" Width="34" Padding="0"/>
      </StackPanel>
      <Popup x:Name="FeedbackPopup" PlacementTarget="{Binding ElementName=FeedbackButton}" Placement="Bottom"
             VerticalOffset="7" StaysOpen="False" AllowsTransparency="True">
        <Border Style="{StaticResource Card}" Width="204" Padding="15" KeyDown="FeedbackSettingsKeyDown">
          <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <TextBlock Text="Interface feedback" FontWeight="SemiBold" Margin="0,0,0,11"/>
            <CheckBox x:Name="SoundsToggle" Content="Interface sounds" IsChecked="True"
                      Checked="FeedbackSettingChanged" Unchecked="FeedbackSettingChanged"/>
            <CheckBox x:Name="MotionToggle" Content="Animations" IsChecked="True" Margin="0,10,0,0"
                      Checked="FeedbackSettingChanged" Unchecked="FeedbackSettingChanged"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="133"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
            <Grid Margin="16,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="SignalDot" Width="8" Height="8" Fill="{DynamicResource IdleBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="SignalTitle" Text="Preview" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SnapshotButton" Content="Snapshot" IsEnabled="False" ToolTip="Save a PNG snapshot"
                        Click="Snapshot" Padding="10,5" Margin="0,0,6,0"/>
                <Button x:Name="FullscreenButton" Content="Fullscreen ⛶" IsEnabled="False" ToolTip="Fullscreen preview (F11). Hover the top-right corner to exit."
                        Click="Fullscreen" Padding="10,5"/>
              </StackPanel>
            </Grid>
            <Border x:Name="RecordBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource RecordSurface}" CornerRadius="9" Padding="9,5">
              <TextBlock x:Name="RecordTime" Text="● REC  00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource RecordText}"/>
            </Border>
            <Grid Grid.Row="1" Background="#101116" x:Name="PreviewSurface" ClipToBounds="True">
              <Border x:Name="VideoHost" Visibility="Collapsed"/>
              <Grid x:Name="EmptyState" Background="{DynamicResource EmptyBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                  <Border Width="104" Height="61" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                          Background="{DynamicResource CardBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Grid Width="78" Height="34">
                      <Border Width="47" Height="29" CornerRadius="5" BorderThickness="1.6"
                              BorderBrush="{DynamicResource ControlLineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Path Data="M 0,4 L 8,4 M 4,0 L 4,8" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}" Margin="0,0,0,3"/>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource BrandBrush}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock Text="No video signal" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Choose a capture card or open Phone screen." Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,17" HorizontalAlignment="Center"/>
                  <Button x:Name="DemoButton" Content="Try a test signal" Click="ToggleDemo" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <Border x:Name="DemoBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="14" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="9,5">
                <TextBlock Text="Test signal" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Accent}"/>
              </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="16,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PreviewFormat" Text="Waiting for a signal" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="EnhancementStatus" Grid.Column="1" Text="DIRECT3D PREVIEW" Foreground="{DynamicResource Accent}"
                         FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="AudioInputTitle" Text="Audio input" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox x:Name="MonitorToggle" Content="Listen on this PC" HorizontalAlignment="Right" VerticalAlignment="Top"
                      IsEnabled="False" Checked="MonitorChanged" Unchecked="MonitorChanged"
                      ToolTip="Use headphones to avoid microphone feedback. Adds output-device buffering."/>
            <ComboBox x:Name="AudioDevices" Grid.Row="1" AutomationProperties.Name="Audio input"
                      ToolTip="Audio capture device. Choose the capture card audio or a microphone."/>
            <Grid x:Name="PhoneVolumeControls" Grid.Row="1" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Phone volume" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Slider x:Name="PhoneVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="100" IsEnabled="False"
                      SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center" ValueChanged="PhoneVolumeChanged"
                      AutomationProperties.Name="Phone volume"/>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                         Text="{Binding Value, ElementName=PhoneVolume, StringFormat={}{0:0}%}"/>
            </Grid>
            <Grid x:Name="InputAudioMeters" Grid.Row="2" Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="L" FontFamily="Consolas" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/>
              <ProgressBar x:Name="LeftMeter" Grid.Column="1" Height="5" Minimum="0" Maximum="1"
                           Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource Accent}"/>
              <TextBlock x:Name="LeftDb" Grid.Column="2" Text="−∞ dB" FontFamily="Consolas" Foreground="{DynamicResource Muted}"
                         FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="R" FontFamily="Consolas" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/>
              <ProgressBar x:Name="RightMeter" Grid.Row="1" Grid.Column="1" Height="5" Minimum="0" Maximum="1"
                           Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource Accent}"/>
              <TextBlock x:Name="RightDb" Grid.Row="1" Grid.Column="2" Text="−∞ dB" FontFamily="Consolas" Foreground="{DynamicResource Muted}"
                         FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,13">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Style="{StaticResource SectionIndex}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                  <TextBlock Text="Input" Style="{StaticResource SectionHeading}"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="↻" HorizontalAlignment="Right" Width="32" Padding="0"
                        AutomationProperties.Name="Refresh devices" ToolTip="Refresh connected devices" Click="RefreshDevices"/>
              </Grid>
              <TextBlock Text="Video device" Style="{StaticResource Label}"/>
              <ComboBox x:Name="VideoDevices" SelectionChanged="VideoDeviceChanged" AutomationProperties.Name="Video device" ToolTip="HDMI / USB capture device"/>
              <TextBlock Text="Capture format" Style="{StaticResource Label}" Margin="0,11,0,6"/>
              <ComboBox x:Name="VideoModes" AutomationProperties.Name="Capture format" ToolTip="Native resolution, frame rate and pixel format reported by your device"/>
              <TextBlock x:Name="InputHint" Text="Connect an HDMI / USB capture card to get started." Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
              <Button x:Name="PhoneScreenButton" Content="Phone screen…" Click="OpenPhoneScreen" Margin="0,10,0,0"
                      ToolTip="Preview an Android phone connected by USB."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <Border Style="{StaticResource SectionIndex}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                <TextBlock Text="Output" Style="{StaticResource SectionHeading}"/>
              </StackPanel>
              <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel>
                  <TextBlock Text="Frame generation" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="PreviewFrameGeneration" SelectedIndex="0" SelectionChanged="FrameGenerationChanged"
                            AutomationProperties.Name="Frame generation"
                            ToolTip="Adaptive modes buffer one content frame for interpolation. Experimental Predictive modes estimate motion between captures with no frame buffering. Preview only.">
                    <ComboBoxItem Content="Off · Lowest delay"/>
                    <ComboBoxItem Content="Adaptive 2× · Motion checked"/>
                    <ComboBoxItem Content="Adaptive 3× · Motion checked"/>
                    <ComboBoxItem Content="Adaptive 4× · Motion checked"/>
                    <ComboBoxItem Content="Predictive 60 FPS · Experimental"/>
                    <ComboBoxItem Content="Predictive 120 FPS · Experimental"/>
                    <ComboBoxItem Content="Predictive 180 FPS · Experimental"/>
                    <ComboBoxItem Content="Gap recovery · Late frames only"/>
                  </ComboBox>
                  <TextBlock x:Name="FrameGenerationHint" Text="Off · lowest preview delay" Foreground="{DynamicResource Muted}"
                             FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <CheckBox x:Name="Capped30GameToggle" Content="Force 30 FPS game cadence" Checked="Capped30GameChanged" Unchecked="Capped30GameChanged"
                            Margin="0,9,0,0" ToolTip="Use when automatic 30 FPS detection is unreliable. Applies to Adaptive and Predictive modes."/>
                  <CheckBox x:Name="SourcePacingToggle" Content="Sync preview to display" IsChecked="True" Margin="0,9,0,0"
                            Checked="SourcePacingChanged" Unchecked="SourcePacingChanged"
                            ToolTip="Synchronize preview presentation to the display refresh. With frame generation off or set to Gap recovery, early frames may wait briefly to even out their spacing."/>
                  <CheckBox x:Name="SteadyFullscreenPacingToggle" Content="Steady fullscreen cadence" Margin="0,9,0,0"
                            Checked="SteadyFullscreenPacingChanged" Unchecked="SteadyFullscreenPacingChanged"
                            IsEnabled="{Binding IsChecked, ElementName=SourcePacingToggle}"
                            ToolTip="With frame generation off, space captured frames evenly on matching displays, such as 60 FPS on 180 Hz or 240 Hz. May hold early frames for up to one display refresh."/>
                </StackPanel>
              </Border>
              <TextBlock Text="Fullscreen display" Style="{StaticResource Label}" Margin="0,13,0,6"/>
              <ComboBox x:Name="FullscreenDisplay" DropDownOpened="FullscreenDisplayOpened" SelectionChanged="FullscreenDisplayChanged"
                        AutomationProperties.Name="Fullscreen display"/>
              <CheckBox x:Name="FullscreenEdgeSmoothing" Content="Smooth jagged edges in fullscreen" IsChecked="True"
                        Checked="FullscreenEdgeSmoothingChanged" Unchecked="FullscreenEdgeSmoothingChanged" Margin="0,9,0,0"
                        ToolTip="Smooths stair-step edges from the console video at native size and when upscaling."/>
              <TextBlock Text="Preview upscaling" Style="{StaticResource Label}" Margin="0,13,0,6"/>
              <ComboBox x:Name="PreviewUpscaling" SelectedIndex="0" SelectionChanged="UpscalingChanged" AutomationProperties.Name="Preview upscaling"
                        ToolTip="Normal uses NVIDIA Image Scaling. RTX Video runs the NVIDIA AI model when the preview is enlarged and falls back to Normal when unavailable.">
                <ComboBoxItem Content="Standard · Fast scaling"/>
                <ComboBoxItem Content="Normal · Adaptive detail"/>
                <ComboBoxItem Content="RTX Video Super Resolution"/>
                <ComboBoxItem Content="Performance · Lowest GPU load"
                              ToolTip="Uses basic scaling without preview sharpening or fullscreen edge smoothing."/>
              </ComboBox>
              <TextBlock x:Name="RtxVideoHint" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Grid Margin="0,12,0,5">
                <TextBlock Text="Preview sharpness" Style="{StaticResource Label}" Margin="0"/>
                <TextBlock x:Name="SharpnessValue" Text="25%" Foreground="{DynamicResource Accent}" FontSize="11"
                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
              </Grid>
              <Slider x:Name="Sharpness" Minimum="0" Maximum="1" Value="0.25" ValueChanged="SharpnessChanged" SmallChange="0.05"
                      AutomationProperties.Name="Preview sharpness" ToolTip="GPU sharpening on the preview only."/>
              <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="12" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                  <CheckBox x:Name="AiVideoToggle" Content="AI Video Super Resolution" IsChecked="False" Checked="AiVideoChanged" Unchecked="AiVideoChanged"
                            ToolTip="Optional NVIDIA RTX Video filter for finished capture video. Requires a supported RTX GPU. Preview only."/>
                  <TextBlock x:Name="AiVideoHint" Text="Off · uses the selected preview filter" Foreground="{DynamicResource Muted}"
                             FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <StackPanel x:Name="AiVideoControls" IsEnabled="False" Margin="0,9,0,0"
                              Visibility="{Binding IsChecked, ElementName=AiVideoToggle, Converter={StaticResource ShowWhenEnabled}}">
                    <TextBlock Text="AI output resolution" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="AiVideoResolution" SelectedIndex="0" SelectionChanged="AiVideoChanged" AutomationProperties.Name="AI output resolution">
                      <ComboBoxItem Content="Auto · Fit preview"/><ComboBoxItem Content="720p · HD"/>
                      <ComboBoxItem Content="1080p · Full HD"/><ComboBoxItem Content="1440p · QHD"/><ComboBoxItem Content="4K · Ultra HD"/>
                    </ComboBox>
                    <TextBlock Text="AI quality" Style="{StaticResource Label}" Margin="0,9,0,6"/>
                    <ComboBox x:Name="AiVideoQuality" SelectedIndex="2" SelectionChanged="AiVideoChanged" AutomationProperties.Name="AI quality">
                      <ComboBoxItem Content="Performance"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="High"/>
                      <ComboBoxItem Content="Ultra · Maximum quality"/>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <Border Style="{StaticResource SectionIndex}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                <TextBlock Text="Recording" Style="{StaticResource SectionHeading}"/>
              </StackPanel>
              <TextBlock Text="Recording resolution" Style="{StaticResource Label}"/>
              <ComboBox x:Name="OutputResolution" SelectedIndex="0" AutomationProperties.Name="Recording resolution">
                <ComboBoxItem Content="Match input" Tag="0"/><ComboBoxItem Content="1080p · 1920 × 1080" Tag="1080"/>
                <ComboBoxItem Content="1440p · 2560 × 1440" Tag="1440"/><ComboBoxItem Content="4K · 3840 × 2160" Tag="2160"/>
              </ComboBox>
              <TextBlock Text="H.264 bitrate" Style="{StaticResource Label}" Margin="0,11,0,6"/>
              <ComboBox x:Name="Bitrate" SelectedIndex="1" AutomationProperties.Name="H.264 bitrate">
                <ComboBoxItem Content="20 Mbps · Compact" Tag="20"/><ComboBoxItem Content="40 Mbps · High quality" Tag="40"/>
                <ComboBoxItem Content="80 Mbps · Very high quality" Tag="80"/><ComboBoxItem Content="120 Mbps · Maximum quality" Tag="120"/>
              </ComboBox>
              <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Save to" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="FolderLabel" Text="Videos / Xeno Capture" Foreground="{DynamicResource Muted}" FontSize="11"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="FolderButton" Grid.Column="1" Content="Browse" Padding="9,4" VerticalAlignment="Center"
                        Click="ChooseFolder" ToolTip="Choose recording folder"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid VerticalAlignment="Center" Margin="0,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="8,5" Margin="0,0,9,0">
          <TextBlock Text="Low buffer" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11"/>
        </Border>
        <TextBlock x:Name="Metrics" Grid.Column="1" Text="— fps shown     ·     — fps input" Foreground="{DynamicResource Muted}"
                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ConnectButton" Content="Play" Style="{StaticResource PrimaryButton}"
                Click="ToggleCapture" Margin="0,0,8,0"/>
        <Button x:Name="RecordButton" Content="●  Record" IsEnabled="False" MinHeight="39" Padding="17,8" Click="ToggleRecording"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Text="Finding connected devices…" Foreground="{DynamicResource Muted}" FontSize="11"
                 VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <TextBlock x:Name="VersionLabel" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom"/>
    </Grid>
  </Grid>
</Window>
